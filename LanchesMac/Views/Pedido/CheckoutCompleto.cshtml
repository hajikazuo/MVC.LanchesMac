@model Pedido

<div class="py-5 my-5">

    <div class="container">
        <div class="row">

            <div class="col-lg-7 mx-auto text-center my-6">
                <h5 class="fw-bold fs-3 fs-lg-5 lh-sm my-6">@ViewBag.CheckoutCompletoMensagem</h5>
            </div>

            <div class="col-12">
                <div class="card card-span mb-3 shadow-lg">
                    <div class="card-body py-0">
                        <div class="row justify-content-center">
                            <div class="col-md-12 col-xl-5 col-xxl-4 p-4 p-lg-5 p-3">
                                <p>Cliente : <strong>@Model.Nome</strong>
                                <p>Data do Pedido :  <strong>@Model.PedidoEnviado</strong>
                                <p>Número do Pedido   : <strong>@Model.PedidoId</strong></p>
                            </div>
                            <div class="col-md-5 col-xl-7 col-xxl-8 g-0 order-md-0 p-3">
                                <table class="table table-bordered">
                                    <tr>
                                        <th></th>
                                        <th>Quantidade</th>
                                        <th>Lanche</th>
                                        <th>Preço</th>
                                    </tr>
                                    @foreach (var item in Model.PedidoItens)
                                    {
                                        <tr>
                                            <td><img src="~/img/products/@item.Lanche.ImagemUrl" width="40" height="40" /></td>
                                            <td>@item.Quantidade</td>
                                            <td>@item.Lanche.Nome</td>
                                            <td>@item.Lanche.Preco</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            <hr />
                            <h4>Valor Total do Pedido: <strong>@(((decimal)ViewBag.TotalPedido).ToString("C2"))</strong></h4>
                            <div class="form-group" style="text-align :center">
                                <h3>
                                    <a class="nav-link text-info" asp-controller="Home" asp-action="Index">Retornar</a>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>