@model HomeViewModel

<div class="overflow-hidden bg-primary">
    <div class="container-fluid p-0">

        <partial name="_Carousel" />

    </div>
</div>

<div>
    <div class="container">
        <div class="row h-100">
            <div class="col-lg-7 mx-auto text-center my-6">
                <h5 class="fw-bold fs-3 fs-lg-5 lh-sm my-6">Os mais vendidos da semana</h5>
            </div>
        </div>
        <div class="row gx-2">
            @foreach (var lanche in Model.LanchesPreferidos)
            {
                <partial name="_LanchesResumo" for="@lanche" />
            }
        </div>
    </div>
</div>
