@model Lanche

<div class="col-sm-6 col-md-4 mb-5 h-100">
    <div class="card card-span h-100 rounded-3">
        <img class="img-fluid rounded-3 h-100" src="~/img/products/@Model.ImagemUrl" alt="..." />
        <div class="card-body ps-0">
            <a asp-controller="Lanche" asp-action="Details" asp-route-lancheId="@Model.LancheId">
                <h5 class="fw-bold text-1000 text-truncate mb-1">@Model.Nome</h5>
            </a>
            <div><span class="text-primary">@Model.DescricaoCurta</span></div><span class="text-1000 fw-bold">@Model.Preco.ToString("c")</span>
        </div>
    </div>
    <div class="d-grid gap-2"><a asp-controller="CarrinhoCompra" asp-action="AdicionarItemNoCarrinhoCompra" asp-route-lancheId="@Model.LancheId" class="btn btn-lg btn-danger" role="button">Adicionar ao Carrinho</a></div>
</div>
