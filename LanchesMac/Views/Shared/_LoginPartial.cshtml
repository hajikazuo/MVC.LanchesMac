@using LanchesMac.Models.Usuarios
@using Microsoft.AspNetCore.Identity

@inject SignInManager<Usuario> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="" asp-controller="Account" asp-action="Logout" id="logoutForm" method="post" class="navbar-left">
        <button type="submit" class="btn btn-white shadow-warning text-warning">
            <i class="fa-solid fa-right-from-bracket me-2"></i>
                Logout : @User.Identity.Name &nbsp;
        </button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@string.Format("{0}{1}",Context.Request.Path, Context.Request.QueryString)" class="btn btn-white shadow-warning text-warning"> <i class="fas fa-user me-2"></i>Login</a>
}