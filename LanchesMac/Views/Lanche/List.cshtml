@model LancheListViewModel

@{
    ViewData["Title"] = "List";
}

<div>
    <div class="container">
        <div class="row h-100">
            <div class="col-lg-7 mx-auto text-center my-6">
                <h5 class="fw-bold fs-3 fs-lg-5 lh-sm my-6">@Model.CategoriaAtual</h5>
            </div>
        </div>
        <div class="row gx-2">
            @foreach (var lanche in Model.Lanches)
            {
                @await Html.PartialAsync("_LanchesResumo", lanche)
            }
        </div>
    </div>
</div>
