@model LanchesMac.Models.Categoria

@{
    var pageName = "Deletar";
    ViewData["Title"] = pageName;
    ViewData["Category1"] = "Categorias";
    ViewData["Heading"] = "Categorias: <span class='fw-300'>Deletar</span>";
}

<div class="container-fluid mt-3">

    <div class="card mb-4">
        <div class="card-header">
            <h5>@pageName</h5>
        </div>
        <div class="card-body">

            <h3 class="text-danger py-3">Você tem certeza que deseja deletar?</h3>
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.CategoriaNome)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.CategoriaNome)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Descricao)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Descricao)
                </dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="CategoriaId" />
                <input type="submit" value="Deletar" class="btn btn-danger" />
                <a class="btn btn-outline-secondary" asp-action="Index">Voltar para a lista</a>
            </form>
        </div>
    </div>
</div>