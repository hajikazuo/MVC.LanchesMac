@model int 

@{
    var title = "Pedido não encontrado";    
    ViewData["Title"] = "title";
}

<div class="alert alert-danger mt-1 mb-1">
    <h1>@title</h1>
    <hr />
    <h2>
        Pedido com id: @Model não encontrado
    </h2>
</div>

<a asp-action="Index" asp-controller="AdminPedidos" class="btn btn-outline-success">Voltar para a lista</a>