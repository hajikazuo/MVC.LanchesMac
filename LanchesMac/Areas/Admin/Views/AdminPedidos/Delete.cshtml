@model LanchesMac.Models.Pedido

@{
    var pageName = "Deletar";
    ViewData["Title"] = pageName;
    ViewData["Category1"] = "Pedidos";
    ViewData["Heading"] = "Pedidos: <span class='fw-300'>Deletar</span>";
}

<div class="container-fluid mt-3">

    <div class="card mb-4">
        <div class="card-header">
            <h5>@pageName</h5>
        </div>
        <div class="card-body">

            <h3 class="text-danger py-3">Você tem certeza que deseja deletar?</h3>

            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Nome)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Sobrenome)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Sobrenome)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Endereco1)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Endereco1)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Endereco2)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Endereco2)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Cep)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Cep)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Cidade)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Cidade)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Telefone)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Telefone)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Email)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Email)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PedidoEnviado)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.PedidoEnviado)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.PedidoEntregueEm)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.PedidoEntregueEm)
                </dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="PedidoId" />
                <input type="submit" value="Deletar" class="btn btn-danger" />
                <a class="btn btn-outline-secondary" asp-action="Index">Voltar para a lista</a>
            </form>
        </div>
    </div>
</div>