@model IEnumerable<LanchesMac.Models.Lanche>

@{
    var pageName = "Lista de produtos";
    ViewData["Title"] = pageName;
    ViewData["Category1"] = "Produtos";
    ViewData["Heading"] = "Produtos: <span class='fw-300'>Listagem</span>";
}

<div class="container-fluid mt-3">

    <div class="card mb-4">
        <div class="card-header">
            <h5>@pageName</h5>
        </div>
        <div class="card-body">
            <p>
                <a class="btn btn-secondary" asp-action="Create">Cadastrar</a>
            </p>
            <table id="myTable" class="table table-bordered">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Nome)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DescricaoCurta)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DescricaoDetalhada)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Preco)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ImagemUrl)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ImagemThumbnailUrl)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsLanchePreferido)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.EmEstoque)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Categoria)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DescricaoCurta)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DescricaoDetalhada)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Preco)
                            </td>
                            <td>
                                <img src="~/img/products/@item.ImagemUrl" width="50" />
                            </td>
                            <td>
                                <img src="~/img/products/tb/@item.ImagemThumbnailUrl" width="50" />
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsLanchePreferido)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EmEstoque)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Categoria.CategoriaNome)
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.LancheId">Editar</a> |
                                <a asp-action="Details" asp-route-id="@item.LancheId">Detalhes</a> |
                                <a asp-action="Delete" asp-route-id="@item.LancheId">Deletar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>