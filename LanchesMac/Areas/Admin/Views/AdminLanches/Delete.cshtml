@model LanchesMac.Models.Lanche

@{
    var pageName = "Deletar";
    ViewData["Title"] = pageName;
    ViewData["Category1"] = "Produtos";
    ViewData["Heading"] = "Produtos: <span class='fw-300'>Deletar</span>";
}

<div class="container-fluid mt-3">

    <div class="card mb-4">
        <div class="card-header">
            <h5>@pageName</h5>
        </div>
        <div class="card-body">

            <h3 class="text-danger py-3">Você tem certeza que deseja deletar?</h3>
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Nome)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.DescricaoCurta)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.DescricaoCurta)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.DescricaoDetalhada)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.DescricaoDetalhada)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Preco)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Preco)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ImagemUrl)
                </dt>
                <dd class="col-sm-10">
                    <img src="~/img/products/@Model.ImagemUrl" width="100" />
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ImagemThumbnailUrl)
                </dt>
                <dd class="col-sm-10">
                    <img src="~/img/products/tb/@Model.ImagemThumbnailUrl" width="50" />
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.IsLanchePreferido)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.IsLanchePreferido)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.EmEstoque)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.EmEstoque)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Categoria)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Categoria.CategoriaNome)
                </dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="LancheId" />
                <input type="submit" value="Deletar" class="btn btn-danger" />
                <a class="btn btn-outline-secondary" asp-action="Index">Voltar para a lista</a>
            </form>
        </div>
    </div>
</div>
