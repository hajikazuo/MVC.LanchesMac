<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/admin/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>
<body>
    <partial name="_Navbar" />

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Cadastros</div>
                        <a class="nav-link" asp-area="Admin" asp-controller="AdminLanches" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-burger"></i></div>
                            Produtos
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="AdminCategorias" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-list"></i></div>
                            Categorias
                        </a>                      
                        <div class="sb-sidenav-menu-heading">Relatórios</div>
                        <a class="nav-link" asp-area="Admin" asp-controller="AdminRelatorioVendas" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-clipboard"></i></div>
                            Relatório de vendas
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="AdminPedidos" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fa-regular fa-note-sticky"></i></div>
                            Pedidos
                        </a>
                        <div class="sb-sidenav-menu-heading">Interface</div>
                        <a class="nav-link" asp-area="Admin" asp-controller="AdminImagens" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-image"></i></div>
                            Gerenciar imagens
                        </a>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Logado como:</div>
                    @User.Identity.Name
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main>
                <partial name="_PageHeading" />
                <partial name="_Breadcrumb" />
                @RenderBody()
            </main>

            <partial name="_Footer" />
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/admin/scripts.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>